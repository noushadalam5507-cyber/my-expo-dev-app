{
  "expo": {
    "name": "NovaGrand Pro",
    "slug": "novagrand-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./adaptive-icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./adaptive-icon.png",
        "backgroundColor": "#05070a"
      },
      "package": "com.novagrand.pro",
      "versionCode": 1,
      "googleServicesFile": "google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NovaGrand to access camera for live video"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NovaGrand to access your photo gallery for reels"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow NovaGrand to access microphone for call"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fa51faa6-e19e-4560-8cb2-0ced59993f3b"
      }
    }
  }
}
